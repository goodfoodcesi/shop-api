{
  "name": "shop-api",
  "version": "2.0.0",
  "description": "",
  "main": "dist/src/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx --watch --env-file=.env src/server.ts",
    "build": "tsc --build tsconfig.json && tsc-alias -p tsconfig.json && tsc-esm-fix dist && copyfiles -u 1 'src/**/*.yaml' dist/src/",
    "lint:fix": "eslint --fix .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "format": "prettier --write .",
    "lint": "eslint . --ext .ts",
    "start": "node --env-file=.env dist/src/server.js ",
    "docker:dev": "docker compose -f compose.dev.yaml up --build -d",
    "docker:prod": "docker compose -f compose.yaml up --build -d",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@tsconfig/node22": "^22.0.2",
    "@types/amqplib": "^0.10.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/winston": "^2.4.4",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "@vitest/coverage-v8": "^2.1.8",
    "@vitest/ui": "^2.1.8",
    "drizzle-kit": "^0.30.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "globals": "^17.3.0",
    "jiti": "^2.6.1",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "tsc-alias": "^1.8.16",
    "tsc-esm-fix": "^3.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.54.0"
  },
  "dependencies": {
    "@scalar/express-api-reference": "^0.8.24",
    "amqplib": "^0.10.5",
    "compression": "^1.8.1",
    "copyfiles": "^2.4.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.44.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-request-id": "^3.0.0",
    "fs": "^0.0.1-security",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "minio": "^8.0.6",
    "module-alias": "^2.2.3",
    "multer": "^2.0.2",
    "npm": "^11.0.0",
    "pg": "^8.16.3",
    "pino": "^10.1.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.2",
    "winston": "^3.19.0",
    "yaml": "^2.8.1",
    "zod": "^3.24.1"
  }
}