{
  "name": "goodfood-test",
  "version": "0.1.0",
  "main": "dist/src/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx --watch --env-file=.env src/server.ts",
    "build": "tsc --build tsconfig.json && tsc-alias -p tsconfig.json && tsc-esm-fix dist && copyfiles -u 1 'src/**/*.yaml' dist/src/",
    "type-check": "tsc --noEmit",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "lint": "eslint . --ext .ts",
    "start": "node --env-file=.env dist/src/server.js ",
    "docker:dev": "docker compose -f compose.dev.yaml up --build -d",
    "docker:prod": "docker compose -f compose.yaml up --build -d"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@tsconfig/node22": "^22.0.2",
    "@types/amqplib": "^0.10.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.5.0",
    "@types/pg": "^8.15.6",
    "@types/yamljs": "^0.2.34",
    "drizzle-kit": "^0.31.6",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prisma": "^6.16.1",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsc-esm-fix": "^3.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.19.1"
  },
  "dependencies": {
    "@scalar/express-api-reference": "^0.8.24",
    "amqplib": "^0.10.5",
    "copyfiles": "^2.4.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.44.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-request-id": "^3.0.0",
    "fs": "^0.0.1-security",
    "jsonwebtoken": "^9.0.2",
    "minio": "^8.0.6",
    "module-alias": "^2.2.3",
    "multer": "^2.0.2",
    "npm": "^11.0.0",
    "pg": "^8.16.3",
    "pino": "^10.1.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.2",
    "yaml": "^2.8.1",
    "zod": "^3.24.1"
  }
}
